# ==================== 資料庫 ====================
DATABASE_URL="postgresql://postgres:password@localhost:5432/hanben_admin?schema=public"

# ==================== NextAuth.js v5 ====================
# 使用 openssl rand -base64 32 產生強隨機 secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ==================== ECPay 金流 ====================
# test | production
ECPAY_ENV="test"
# 測試: 3002607 / 正式: 填入正式 MerchantID
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""

# ==================== ECPay 物流 ====================
# 測試: 2000132 / 正式: 填入正式 MerchantID
ECPAY_LOGISTICS_MERCHANT_ID=""
ECPAY_LOGISTICS_HASH_KEY=""
ECPAY_LOGISTICS_HASH_IV=""

# 綠界物流寄件人資料
ECPAY_SENDER_NAME=""
ECPAY_SENDER_PHONE=""
ECPAY_SENDER_ZIP=""
ECPAY_SENDER_ADDRESS=""

# ==================== UploadThing ====================
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ==================== Resend (Email) ====================
# 需先在 Resend 驗證你的寄信網域（建議使用子網域，例如 mail.hanben.com.tw）
RESEND_API_KEY=""
# 必須使用已在 Resend 驗證通過的寄件位址，例如 noreply@mail.hanben.com.tw
RESEND_FROM_EMAIL="noreply@hanben.com.tw"

# ==================== Sentry (錯誤追蹤, 選填) ====================
# 目前 repo 尚未完成 Sentry SDK 接線；這兩個值先視為保留欄位
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
